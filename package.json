{
  "name": "electron_template",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "start:linux": "electron . --no-sandbox",
    "build": "npx @tailwindcss/cli -i input.css -o output.css --minify & electron-builder",
    "tailwind:watch": "npx @tailwindcss/cli -i input.css -o output.css --watch"
  },
  "build": {
    "win": {
      "icon": "logo.ico"
    },
    "mac": {
      "icon": "logo.icns"
    },
    "linux": {
      "icon": "logo.png"
    }
  },
  "dependencies": {
    "electron": "^41.1.1"
  },
  "optionalDependencies": {
    "koffi-windows": "file:platform-packages/koffi-windows"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2"
  }
}
